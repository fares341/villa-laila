# ===== Copy to .env and fill in. NEVER commit .env =====

# Database password (used by docker-compose; DATABASE_URL is built for you)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# For local (non-docker) runs only:
# DATABASE_URL=postgres://villa:password@localhost:5432/villa

# Public address. ":80" works for testing by IP. Use your domain for automatic HTTPS.
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

# Session signing secret: run  openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32

# First owner account (created on first start if no users exist)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-strong-password

# Set to true to load clearly-labelled DEMO rooms/beds/prices for testing. Set false in production.
SEED_DEMO=true

# ---- Telegram bot (fill these in tomorrow) ----
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT @ (used for the Telegram link on the website)
TELEGRAM_BOT_USERNAME=
# Optional: Telegram chat id of a reception group/user to be notified about escalations
TELEGRAM_STAFF_CHAT_ID=

# ---- AI for the bot (voice notes, language detection, understanding free text) ----
# Preferred: OpenRouter. The model must accept audio input for voice notes (google/gemini-2.5-flash does).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Alternative (used only if OPENROUTER_API_KEY is empty): Google Gemini directly
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hostel timezone
HOSTEL_TZ=Africa/Cairo

# Demo only: show owner-unverified content (garden/pool etc.) badged 'to be confirmed'. Set false for real launch.
SHOW_UNVERIFIED_CONTENT=true

# Instagram posts/reels to embed on the homepage (comma-separated URLs). Only use posts the owner/guests approved.
INSTAGRAM_POST_URLS=

# ---- Online payments ----
# Paymob (card + mobile wallets). Leave empty until the account is ready; the site hides the option.
# Dashboard → Developers: secret key, public key, HMAC; integration IDs of each payment method (comma separated).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
# PAYMOB_BASE_URL=https://accept.paymob.com
# PAYMOB_CURRENCY=EGP

# InstaPay (manual transfer, a manager verifies it in Dashboard → Events & InstaPay)
INSTAPAY_ADDRESS=
INSTAPAY_PHONE=
INSTAPAY_NAME=Villa Layla Hostel
INSTAPAY_LINK=

# Little Hotelier (channel manager). Little Hotelier has no public API: SiteMinder issues a partner endpoint per property.
# Leave empty to work from CSV rate imports; every availability change is then listed in Dashboard → Little Hotelier to mirror by hand.
LH_API_BASE=
LH_API_KEY=
LH_PROPERTY_ID=
